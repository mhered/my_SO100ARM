<robot name="sensor_d435"
    xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:macro name="box_inertial" params="x y z mass">
        <inertial>
            <mass value="${mass}" />
            <origin xyz="-0.15 0 0.03" />
            <inertia ixx="${0.0833333 * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0" iyy="${0.0833333 * mass * (x*x + z*z)}" iyz="0.0" izz="${0.0833333 * mass * (x*x + y*y)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="realsense" params="world_link_name *origin">
        <link name="realsense_link">
            <xacro:box_inertial x="0.02" y="0.1" z="0.01" mass="0.06"/>


            <collision name="collision">
                <origin rpy="0 0 ${pi/2}"/>
                <geometry>
                    <mesh filename="package://my_sensors/realsense_d435/meshes/realsense.dae" />
                </geometry>
            </collision>
            <visual name= "visual">
                <origin rpy="0 0 ${pi/2}"/>
                <geometry>
                    <mesh filename="package://my_sensors/realsense_d435/meshes/realsense.dae"/>
                </geometry>
                <gazebo>
                    <material>
                        <diffuse>1.0 1.0 1.0</diffuse>
                        <specular>1.0 1.0 1.0</specular>
                        <pbr>
                            <metal>
                                <albedo_map>package://my_sensors/realsense_d435/materials/textures/RealSense_Albedo.png</albedo_map>
                                <normal_map>package://my_sensors/realsense_d435/materials/textures/RealSense_Normal.png</normal_map>
                                <metalness_map>package://my_sensors/realsense_d435/materials/textures/RealSense_Metalness.png</metalness_map>
                                <roughness_map>package://my_sensors/realsense_d435/materials/textures/RealSense_Roughness.png</roughness_map>
                            </metal>
                        </pbr>
                        <!-- fallback to script if no PBR support-->
                        <script>
                            <uri>package://my_sensors/realsense_d435/materials/scripts/</uri>
                            <uri>package://my_sensors/realsense_d435/materials/textures/</uri>
                            <name>UrbanTile/RealSense_Diffuse</name>
                        </script>
                    </material>
                </gazebo>
            </visual>
        </link>

        <gazebo reference="realsense_link">
            <sensor name="realsense_d435" type="rgbd_camera">
                <update_rate>10</update_rate>
                <topic>realsense</topic>
                <camera name="camera">
                    <optical_frame_id>realsense_link</optical_frame_id>
                    <horizontal_fov>1.0472</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.01</near>
                        <far>30</far>
                    </clip>
                    <depth_camera>
                        <clip>
                            <near>0.1</near>
                            <far>30</far>
                        </clip>
                    </depth_camera>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.001</stddev>
                    </noise>
                </camera>
                <always_on>true</always_on>
                <visualize>true</visualize>
            </sensor>
        </gazebo>

        <joint name="realsense_joint" type="fixed">
            <child link="realsense_link" />
            <parent link="${world_link_name}" />
            <xacro:insert_block name="origin"/>
        </joint>
    </xacro:macro>
</robot>
